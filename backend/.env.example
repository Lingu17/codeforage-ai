APP_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
GEMINI_API_KEY=replace-with-server-key
GROQ_API_KEY=replace-with-server-key
GROQ_MODEL=replace-with-available-chat-model
GEMINI_AI_MODEL=replace-with-available-generation-model
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
EMBED_BATCH_SIZE=16
EMBED_WORKERS=2
EMBED_MAX_RETRIES=3
EMBED_REQUESTS_PER_MINUTE=60
AI_TIMEOUT_SECONDS=60
ALLOWED_ORIGINS=http://localhost:3000

# Optional: enables server-only contact submissions. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=
